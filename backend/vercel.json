{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/favicon\\.(ico|png|svg)",
      "status": 204,
      "headers": { "Content-Length": "0" }
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
